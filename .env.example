# ============================================================================
# GIA DELIKSARI WEB — ENVIRONMENT VARIABLES REFERENCE
# Copy this file to .env.local for local dev, or set these in Vercel dashboard
# for production. NEVER commit .env.local — it's in .gitignore.
# ============================================================================

# ===================== SUPABASE =====================
# Get these from your Supabase project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-jwt>
SUPABASE_SERVICE_ROLE_KEY=<service-role-jwt>          # Server-only, bypasses RLS
SUPABASE_ACCESS_TOKEN=<management-api-token>           # Optional, for env sync scripts

# ===================== AUTH =====================
# Random 32+ char string. Used to HMAC-sign the gia_session cookie.
ADMIN_SESSION_SECRET=<random-32-char-string>

# Legacy fallback only — safe to omit when users table is seeded.
# If set, used as last-resort fallback if /api/admin/data is hit before
# the users table check. Not used by /super, /admin, or /kas (all
# authenticated via users table now).
NEXT_PUBLIC_ADMIN_PASSWORD=1515

# ===================== GOOGLE DRIVE (gallery) =====================
# OAuth2 credentials for Drive API access (gallery master archive).
# Setup: see scripts/drive-auth-setup.js
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_UPLOAD_FOLDER_ID=
GOOGLE_DRIVE_PUBLIC_FOLDER_ID=
GOOGLE_DRIVE_NEW_FOLDER_ID=
GOOGLE_DRIVE_FALLBACK_FOLDER_IDS=

# Alternative: Service Account (preferred for server-to-server, no user OAuth).
# Provides broader Drive API scopes and no refresh token expiry.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ===================== YOUTUBE DATA API v3 =====================
# Auto-syncs latest khotbah videos on /home. Free tier: 10K units/day.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCDh3ojx9ne3HOPoBuuoKlrg

# ===================== BACKBLAZE B2 (disaster recovery mirror) =====================
# Optional. If unset, scripts/mirror-drive-to-b2.mjs exits early.
# Sign up at https://www.backblaze.com/b2 (10 GB free tier).
B2_ACCOUNT_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=gia-deliksari-photos-mirror

# ===================== RUNTIME / OBSERVABILITY =====================
# Log level for server-side console output (debug | info | warn | error).
# Defaults to 'info'. Set to 'warn' in production for less noise.
LOG_LEVEL=info