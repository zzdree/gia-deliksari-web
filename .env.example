# ==========================================
# GOOGLE DRIVE & OAUTH (utama untuk upload galeri)
# ==========================================
# Upload galeri memakai OAuth refresh token akun Gmail gereja.
# Service Account TIDAK punya kuota penyimpanan pribadi (403 dari Google),
# jadi OAuth wajib agar foto tersimpan di My Drive gereja sendiri.
# Jalankan `node scripts/drive-auth-setup.js` setelah mengisi Client ID & Secret.
GOOGLE_OAUTH_CLIENT_ID="xxxxx.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="GOCSPX-xxxxx"
GOOGLE_OAUTH_REFRESH_TOKEN=""
NEXT_PUBLIC_GOOGLE_DRIVE_GALLERY_URL="https://drive.google.com/drive/folders/your-folder-id"
GOOGLE_DRIVE_PUBLIC_FOLDER_ID="your-public-folder-id"
GOOGLE_DRIVE_UPLOAD_FOLDER_ID="your-upload-folder-id"

# Fallback metadata-only (opsional): Service Account
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@project.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
